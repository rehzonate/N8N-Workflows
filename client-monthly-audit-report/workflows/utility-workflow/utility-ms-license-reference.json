      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "jsCode": "// Microsoft's licensing CSV is comma-delimited with quoted fields (some product\n// names and String_Ids contain commas, so the parser respects quotes). It is one row PER SERVICE PLAN, not one row per product. A single SKU like\n// Microsoft 365 E5 appears as ~50 rows here, all sharing the same\n// Product_Display_Name/String_Id/GUID but differing in Service_Plan_Name/Id.\n// We dedupe below to keep exactly one row per unique product GUID.\n\nconst raw = $input.first().binary?.data\n  ? Buffer.from($input.first().binary.data.data, 'base64').toString('utf-8')\n  : $input.first().json.data; // adjust based on how the HTTP node returns it\n\nfunction parseCsvLine(line) {\n  const fields = [];\n  let cur = '', inQuotes = false;\n  for (let i = 0; i < line.length; i++) {\n    const c = line[i];\n    if (c === '\"') { inQuotes = !inQuotes; continue; }\n    if (c === ',' && !inQuotes) { fields.push(cur); cur = ''; continue; }\n    cur += c;\n  }\n  fields.push(cur);\n  return fields;\n}\n\nconst lines = raw.split(/\\r?\\n/).filter(l => l.trim());\nconst header = parseCsvLine(lines[0]);\nconst productIdx = header.indexOf('Product_Display_Name');\nconst stringIdx = header.indexOf('String_Id');\nconst guidIdx = header.indexOf('GUID');\n\nconst rows = [];\nconst seen = new Set();\nfor (let i = 1; i < lines.length; i++) {\n  const f = parseCsvLine(lines[i]);\n  const skuId = f[guidIdx]?.trim();\n  if (!skuId || seen.has(skuId)) continue; // dedupe by GUID, first occurrence wins\n  seen.add(skuId);\n  rows.push({\n    skuId,\n    stringId: f[stringIdx]?.trim() || '',\n    productName: f[productIdx]?.trim() || '',\n  });\n}\n\nreturn rows.map(r => ({ json: r }));"
      },
